ORANGE_ACCOUNTS=[{"name":"home","email":"you@example.com","password":"replace-me"}]
ORANGE_DATA_DIR=/data
ORANGE_TIMEZONE=Europe/Warsaw
ORANGE_LOGIN_ADVANCE_DAYS=7
# Conservative interval after a successful login when Orange does not expose a deadline.
ORANGE_FALLBACK_LOGIN_INTERVAL_DAYS=25
ORANGE_RETRY_DELAY_HOURS=6
ORANGE_OTP_RETRY_DELAY_HOURS=24
ORANGE_BROWSER_HEADLESS=true
# Confirm and update this URL/selectors before enabling a production account.
ORANGE_LOGIN_URL=https://www.orange.pl/twojekonto/
# ORANGE_WEBHOOK_URL=https://your-notification-endpoint.example/events
